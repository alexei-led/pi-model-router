{
  "name": "@alexeiled/pi-model-router",
  "version": "0.12.1",
  "type": "module",
  "files": [
    "extensions",
    "!extensions/**/*.test.ts",
    "!extensions/test",
    "LICENSE",
    "model-router.example.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "description": "Pi model router with classifier-model routing, soft budget controls, and custom-provider support.",
  "keywords": [
    "pi-package",
    "pi",
    "model-router",
    "llm",
    "coding-agent",
    "extension"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@12.0.2",
  "author": "Alexei Ledenev",
  "contributors": [
    "Ye Liu"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexei-led/pi-model-router.git"
  },
  "homepage": "https://github.com/alexei-led/pi-model-router#readme",
  "bugs": {
    "url": "https://github.com/alexei-led/pi-model-router/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./extensions/index.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "build": "tsc",
    "prepublishOnly": "npm run check && npm run test:coverage && npm run check:unused && npm run pack:dry",
    "test": "vitest run --pool=threads",
    "test:coverage": "vitest run --pool=threads --coverage",
    "check:unused": "knip --production",
    "check": "biome check --error-on-warnings . && npm run tsc",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "pack:dry": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^1.1.0",
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@earendil-works/pi-agent-core": "^1.1.0",
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@vitest/coverage-v8": "5.0.1",
    "knip": "6.40.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
