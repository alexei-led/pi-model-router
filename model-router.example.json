{
  "activityRouting": "on",
  "switchPolicy": {
    "horizonRequests": 5,
    "costSensitivity": 0.5,
    "strongAdviceConfidence": 0.9,
    "escalationHoldTurns": 2
  },
  "modes": {
    "cost": {
      "policy": {
        "costSensitivity": 0.8,
        "escalationHoldTurns": 1
      }
    },
    "quality": {
      "policy": {
        "costSensitivity": 0.2,
        "escalationHoldTurns": 4
      }
    }
  },
  "debug": false,
  "advisor": {
    "enabled": false,
    "model": "typesafe/jev-1.14.0",
    "timeoutMs": 10000,
    "reviewEveryRequests": 4,
    "confidenceThreshold": 0.65,
    "probabilityThreshold": 0.8,
    "maxStateTokens": 3000,
    "context": {
      "currentLoopMessages": 8,
      "previousTurns": 2,
      "maxHistoryTokens": 500,
      "toolResults": "last-error",
      "maxToolTokens": 250
    },
    "maxRetries": 1
  },
  "maxSessionBudget": 1,
  "models": {
    "strong": {
      "model": "anthropic/claude-opus-5-5",
      "contextWindow": 200000,
      "effortCacheSharing": "unknown"
    },
    "fast": {
      "model": "anthropic/claude-haiku-5-5",
      "contextWindow": 200000,
      "effortCacheSharing": "unknown"
    },
    "worker": {
      "model": "anthropic/claude-sonnet-5-5",
      "effortCacheSharing": "unknown"
    }
  },
  "profiles": {
    "personal": {
      "mode": "balanced",
      "advisor": {
        "models": ["typesafe/jev-1.14.0"]
      },
      "baselineTier": "medium",
      "high": {
        "model": "strong",
        "thinking": "high"
      },
      "medium": {
        "model": "worker",
        "thinking": "medium"
      },
      "low": {
        "model": "fast",
        "thinking": "low"
      },
      "micro": {
        "model": "fast",
        "thinking": "off"
      },
      "activities": {
        "code": {
          "medium": {
            "model": "strong",
            "thinking": "high"
          }
        },
        "docs": {
          "medium": {
            "model": "fast",
            "thinking": "low",
            "fallbacks": []
          }
        }
      },
      "activityPreset": "auto"
    },
    "work": {
      "mode": "cost",
      "advisor": {
        "models": []
      },
      "high": {
        "model": "strong",
        "thinking": "high"
      },
      "medium": {
        "model": "fast",
        "thinking": "medium"
      },
      "low": {
        "model": "fast",
        "thinking": "low"
      },
      "activityPreset": "auto"
    },
    "openai": {
      "activityPreset": "auto",
      "mode": "balanced",
      "advisor": {
        "models": ["typesafe/jev-1.14.0"]
      },
      "micro": {
        "model": "openai-codex/gpt-6-luna",
